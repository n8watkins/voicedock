# Node
# No trailing slash: also ignores a node_modules symlink, not just a folder.
node_modules
npm-debug.log*
yarn-error.log*

# Piper binaries (download separately - see README)
servers/piper/piper/piper.exe
servers/piper/piper/piper
servers/piper/piper/voices/*.onnx
servers/piper/piper/voices/*.onnx.json
# The rest of Piper's release archive (DLLs, espeak-ng data, libraries)
servers/piper/piper/*.dll
servers/piper/piper/*.ort
servers/piper/piper/*.so*
servers/piper/piper/*.dylib
servers/piper/piper/espeak-ng
servers/piper/piper/espeak-ng-data/
servers/piper/piper/piper_phonemize
servers/piper/piper/pkgconfig/
servers/piper/piper/lib/
# Named node.exe copies that N8 Tray creates beside server.js: n8voice's
# (VoiceDock module) and the retired n8piper's
servers/piper/voicedock-piper.exe
servers/piper/piper-tts-server.exe # legacy-name

# Generated audio output
servers/piper/output/*.wav
servers/piper/output/*.mp3
servers/piper/logs/

# Chrome Web Store packages (npm run package) and release files
web-store/
release-artifacts/

# Environment variables
.env
.env.local
.env.*.local
.local-ops.yaml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Playwright
test-results/
playwright-report/

# Engines installed from the signed catalog (node servers/piper/engines.js)
servers/engines/

# The single-file hub (node tools/build-hub.mjs) and its build folder
servers/piper/voicedock-hub
servers/piper/voicedock-hub.exe
build/
