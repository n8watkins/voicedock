{
  "manifest_version": 3,
  "name": "VoiceDock",
  "version": "1.1.0",
  "description": "Select text and hear it read aloud: Chrome's built-in voice right away, or natural Piper and Kokoro voices on your own computer.",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "offscreen",
    "scripting",
    "storage",
    "tts"
  ],
  "host_permissions": [
    "http://127.0.0.1:7477/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "VoiceDock"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "read-selection": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Read selected text or stop playback"
    },
    "pause-resume": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Pause or resume playback"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
