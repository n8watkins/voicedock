{
  "name": "voicedock",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "node tools/build-extension-ui.mjs",
    "check:names": "node tools/check-names.mjs",
    "package": "node tools/package-store.mjs",
    "test": "node --test && npm run test:kokoro",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "unshare --user --map-root-user --net sh -c 'ip link set lo up && playwright test \"$@\"' playwright",
    "version:patch": "node tools/bump-version.mjs patch",
    "version:minor": "node tools/bump-version.mjs minor",
    "version:major": "node tools/bump-version.mjs major",
    "deploy": "node tools/deploy-windows.mjs",
    "screenshots": "node tools/capture-screenshots.mjs",
    "memory-report": "node tools/memory-report.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run check:names && npm ci --prefix servers/piper && npm test && npm run build",
    "release:artifacts": "node tools/package-store.mjs --out release-artifacts",
    "test:kokoro": "python3 -m unittest discover -s servers/kokoro/tests",
    "catalog:sign": "node tools/catalog-sign.mjs sign",
    "catalog:verify": "node tools/catalog-sign.mjs verify",
    "build:hub": "node tools/build-hub.mjs --smoke"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "release-kit": "github:n8watkins/release-kit#v2.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
